# Copy to .env and fill in. Never commit .env or service account JSON files.
# Recommended: point to the JSON key downloaded from Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Alternatively, set the three service account fields directly:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# On Google Cloud, Application Default Credentials can be used instead.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
